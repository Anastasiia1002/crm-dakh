# Local development (default `npm run dev` / Vite mode "development").
# Staging: copy `.env.staging.example` → `.env.staging`, then `npm run dev:staging`.
# Production builds: set VITE_API_BASE_URL in CI/host env (see `.env.production.example`).
# Never put database URLs, JWT secrets, or admin passwords in Vite env files.
VITE_API_BASE_URL=http://localhost:3000

