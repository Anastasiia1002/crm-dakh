# Staging CRM → staging Nest API only.
# Copy to .env.staging (gitignored). Do NOT point this at production.
#
# Origin shape: scheme + host (+ optional port), no path, no trailing slash.
# Local staging (start-staging-crm on this machine):
#   VITE_API_BASE_URL=http://localhost:3000
# Remote staging API for a client-testable CRM (https only, never production Render):
#   VITE_API_BASE_URL=https://YOUR_STAGING_API_ORIGIN
#
# Default for local staging QA:

VITE_API_BASE_URL=http://localhost:3000
