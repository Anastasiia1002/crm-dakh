    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "test:verify": "npx --yes tsx src/lib/api-env.verify.ts && npx --yes tsx src/lib/api-client.verify.ts && npx --yes tsx src/lib/login-auth.verify.ts && npx --yes tsx src/lib/admin-booking-view.verify.ts && npx --yes tsx src/lib/booking-form.verify.ts && npx --yes tsx src/lib/booking-manage.verify.ts && npx --yes tsx src/lib/inventory-status.verify.ts && npx --yes tsx src/lib/inventory-query.verify.ts && npx --yes tsx src/lib/calendar-adapter.verify.ts"
  },
