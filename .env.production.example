# Production CRM build (Vite mode "production" — `npm run build`).
# Provide this value at deploy time (CI variable / host env). Never commit real origins with secrets.
#
# Rules enforced by vite.config.ts / src/lib/api-env.ts:
# - Required
# - Absolute origin only (no /api path, no credentials, no query)
# - Must be https
# - Must NOT be localhost / 127.0.0.1
#
# Known production Nest API origin (set explicitly in deploy config — do not rely on defaults):
#   https://dakh-backend.onrender.com
#
# Placeholder for local documentation / templates:

VITE_API_BASE_URL=https://YOUR_PRODUCTION_API_ORIGIN
